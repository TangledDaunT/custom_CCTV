[Unit]
Description=CCTV Snapshot Sync to External Disk
Documentation=Syncs snapshot images to laptop for AI training
After=network.target cctv.service
Requires=cctv.service

[Service]
Type=simple
User=shreyansh
Group=shreyansh
EnvironmentFile=/etc/cctv/cctv.env
ExecStart=/usr/local/bin/cctv_sync_snapshots.py --interval 300
Restart=always
RestartSec=60

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log/cctv /var/lib/cctv /mnt/cctv-recordings /tmp /home/shreyansh/.local/state/wacli
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Environment
Environment="CCTV_SYNC_LOG=/var/log/cctv/cctv_sync.log"

# Resource limits
LimitNOFILE=65536
MemoryMax=256M
CPUQuota=20%

[Install]
WantedBy=multi-user.target

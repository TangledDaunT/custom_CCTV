[Unit]
Description=CCTV Streaming + Motion Detection
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__RUN_AS_USER__
WorkingDirectory=/opt/cctv-app
ExecStart=/opt/cctv-app/venv/bin/python app.py
Restart=always
RestartSec=3
MemoryMax=1G

# Give the camera time to be available at boot
ExecStartPre=/bin/sleep 3

# Log motion events to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cctv

[Install]
WantedBy=multi-user.target

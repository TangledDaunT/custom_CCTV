[Unit]
Description=CCTV Live Feed Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_AS_USER__
WorkingDirectory=/opt/cctv-app
EnvironmentFile=/etc/cctv/cctv.env
# Exactly one worker: a USB camera must only be opened by one process.
ExecStart=/opt/cctv-app/venv/bin/gunicorn --workers 1 --threads 8 --bind 127.0.0.1:5000 --access-logfile - --error-logfile - wsgi:app
Restart=always
RestartSec=3
# Keep it from eating all RAM if something goes wrong
MemoryMax=1G
# Give the app time to release the camera cleanly on stop/restart
TimeoutStopSec=10
# Extra group access to the webcam device, on top of usermod done in install.sh
SupplementaryGroups=video
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
# wacli is installed in Linuxbrew and keeps its local WhatsApp session state
# under the service user's home directory. Keep home read-only and grant write
# access only to wacli's own state directory.
ProtectHome=read-only
ReadWritePaths=/var/log/cctv /var/lib/cctv /mnt/cctv-recordings /home/__RUN_AS_USER__/.local/state/wacli
UMask=0077

[Install]
WantedBy=multi-user.target

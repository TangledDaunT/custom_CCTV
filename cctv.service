[Unit]
Description=CCTV Streaming + Motion Detection
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__RUN_AS_USER__
WorkingDirectory=/opt/cctv-app

# Create log dir before starting
ExecStartPre=/bin/mkdir -p /var/log/cctv
ExecStartPre=/bin/chown __RUN_AS_USER__ /var/log/cctv

# Give camera time to be ready at boot
ExecStartPre=/bin/sleep 5

ExecStart=/opt/cctv-app/venv/bin/python app.py

# Always restart — no matter what killed it
Restart=always
RestartSec=5

# Resource limits — keep it lean on old hardware
MemoryMax=800M
CPUQuota=80%

# Logging to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cctv

# Kill cleanly
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

# Copy to /etc/cctv/cctv.env, replace every placeholder, then chmod 600 it.
CCTV_SECRET_KEY=replace-with-a-random-64-character-secret
CCTV_BOOTSTRAP_USERNAME=admin
CCTV_BOOTSTRAP_PASSWORD=replace-with-a-strong-unique-password
CCTV_COOKIE_SECURE=1
CCTV_CAMERA_INDEX=0
CCTV_FRAME_WIDTH=1280
CCTV_FRAME_HEIGHT=720
CCTV_TARGET_FPS=10

# Alerts require this many high-confidence detections of a moving person or vehicle.
CCTV_PERSON_CONFIDENCE=0.70
CCTV_VEHICLE_CONFIDENCE=0.80
CCTV_VERIFY_SAMPLES=6
CCTV_VERIFY_REQUIRED=4
CCTV_VERIFY_INTERVAL_SECONDS=0.20
CCTV_VERIFY_MIN_MOVEMENT_PX=12

# Keep recordings and state separate from deployed application code.
VIDEO_DIR=/mnt/cctv-recordings/cctv_videos
CCTV_STATE_FILE=/var/lib/cctv/alerts_enabled
CCTV_SNAPSHOT_PATH=/var/lib/cctv/cctv_snapshot.jpg

# Comma-separated E.164 numbers, without +, e.g. 919876543210
CCTV_ALERT_NUMBERS=
WACLI_PATH=/home/linuxbrew/.linuxbrew/bin/wacli

# Snapshot sync to laptop (external HDD for AI training)
CCTV_LAPTOP_HOST=100.99.161.57
CCTV_LAPTOP_USER=shreyansh
CCTV_REMOTE_DIR=/mnt/external/cctv_snapshots
